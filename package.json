{
  "name": "simpletasks",
  "author": "@fredmaiaarantes",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "test": "meteor test --once --driver-package meteortesting:mocha",
    "check": "npx @biomejs/biome check --write ./**/*.{js,jsx}",
    "visualize": "meteor --production --extra-packages bundle-visualizer",
    "profile": "meteor profile --exclude-archs web.browser.legacy,web.cordova",
    "test-e2e": "playwright test",
    "test-e2e-headed": "playwright test --headed",
    "test-e2e-report": "npx playwright show-report"
  },
  "meteor": {
    "mainModule": {
      "client": "ui/main.jsx",
      "server": "api/main.js"
    },
    "testModule": {
      "server": "tests/main.js"
    },
    "modern": true
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^2.9.11",
    "@react-icons/all-files": "^4.1.0",
    "@swc/helpers": "^0.5.17",
    "bcrypt": "^5.1.1",
    "framer-motion": "^6.5.1",
    "history": "^5.3.0",
    "meteor-node-stubs": "^1.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^6.25.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@meteorjs/rspack": "^2.2.0",
    "@playwright/test": "^1.52.0",
    "@rsdoctor/rspack-plugin": "^1.5.7",
    "@rspack/cli": "^1.7.1",
    "@rspack/core": "^1.7.1",
    "@rspack/plugin-react-refresh": "^1.4.3",
    "@types/meteor": "^2.9.8",
    "@types/mocha": "^9.1.1",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "chai": "^4.4.1",
    "dotenv": "^16.5.0",
    "react-refresh": "^0.17.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "meteor npm test && lint-staged",
      "post-commit": "git update-index --again"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "biome check --write --unsafe --no-errors-on-unmatched"
    ]
  }
}
